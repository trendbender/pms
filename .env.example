# ---- PMS environment (copy to .env; never commit real secrets) ----

# Postgres (used by the postgres container and the backend)
POSTGRES_USER=pms
POSTGRES_PASSWORD=pms_dev_password_change_me
POSTGRES_DB=pms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DSN the backend uses (async driver)
DATABASE_URL=postgresql+asyncpg://pms:pms_dev_password_change_me@postgres:5432/pms

# Redis
REDIS_URL=redis://redis:6379/0

# Auth / JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# CORS (comma-separated origins the frontend runs on)
CORS_ORIGINS=http://localhost:3000

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# First bootstrap Owner (created by `python -m app.cli seed` if not present)
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=owner_dev_password_change_me
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_WORKSPACE_NAME=Main Workspace

# Object storage (S3-compatible, e.g. Cloudflare R2) — used from Sprint 7
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# SMTP (notifications / invitations) — used from Sprint 7
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Login-screen branding (optional; defaults to a neutral "PMS").
# NEXT_PUBLIC_BRAND_NAME=Acme
# NEXT_PUBLIC_BRAND_BADGE=A
# NEXT_PUBLIC_BRAND_URL=https://acme.example.com
